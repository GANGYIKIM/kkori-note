# 복사해서 .env.local 로 만들고 값을 채우세요. .env.local 은 GitHub에 올리지 않습니다.
OPENAI_API_KEY=

# 목적별 모델 (docs/adr/0001-llm-model-selection.md 참고)
OPENAI_MODEL_PARSE=gpt-6-luna
OPENAI_MODEL_CONSULT=gpt-6.1-terra

# 선택: 목적별 추론 강도 (none | low | medium | high). 비워 두면 parse=none, consult=low
# OPENAI_REASONING_PARSE=none
# OPENAI_REASONING_CONSULT=low

# 선택: 요청 제한 (기본값 사용 시 비워 두세요)
# RATE_LIMIT_DAILY_PER_CLIENT=30
# RATE_LIMIT_DAILY_GLOBAL=500
# MAX_INPUT_CHARS=500
